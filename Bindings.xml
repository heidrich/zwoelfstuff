<Bindings>
    <!--
        The game's own key list, under a ZwoelfStuff heading. The strings it
        shows - BINDING_HEADER_ZWOELFSTUFF and every BINDING_NAME_* - are set
        in Lua (Core/Taunts.lua, Core/Externals.lua, Core/Answers.lua);
        without them a row reads as the raw binding name.

        A body is a plain line of Lua run by the game, so it can only reach a
        GLOBAL. Everything else in this addon lives in its private table.

        THIS FILE MUST NOT BE LISTED IN THE TOC. The game loads it from the
        addon root by itself; in the TOC the UI XML parser reads it instead
        and says "Unrecognized XML: Binding" while the key never appears.
    -->
    <Binding name="ZWOELFSTUFF_TAUNT_ASK" category="ZwoelfStuff" header="ZWOELFSTUFF">
        ZwoelfStuff_TauntAsk()
    </Binding>

    <!--
        ASKING FOR A COOLDOWN. A line of Lua, because asking is a MESSAGE and
        not a spell - and because it then works whether the panel happens to
        be on screen or not, which a click on a hidden button would not. It
        says what it did, and says so when there is nothing in that place.

        The number is the place in the row, counted the way the panel is
        drawn. What sits in it changes as people come and go; the place does
        not, which is the only thing a key can sensibly be bound to.
    -->
    <Binding name="ZWOELFSTUFF_EXTERNAL_1" category="ZwoelfStuff">ZwoelfStuff_ExternalAsk(1)</Binding>
    <Binding name="ZWOELFSTUFF_EXTERNAL_2" category="ZwoelfStuff">ZwoelfStuff_ExternalAsk(2)</Binding>
    <Binding name="ZWOELFSTUFF_EXTERNAL_3" category="ZwoelfStuff">ZwoelfStuff_ExternalAsk(3)</Binding>
    <Binding name="ZWOELFSTUFF_EXTERNAL_4" category="ZwoelfStuff">ZwoelfStuff_ExternalAsk(4)</Binding>
    <Binding name="ZWOELFSTUFF_EXTERNAL_5" category="ZwoelfStuff">ZwoelfStuff_ExternalAsk(5)</Binding>
    <Binding name="ZWOELFSTUFF_EXTERNAL_6" category="ZwoelfStuff">ZwoelfStuff_ExternalAsk(6)</Binding>
    <Binding name="ZWOELFSTUFF_EXTERNAL_7" category="ZwoelfStuff">ZwoelfStuff_ExternalAsk(7)</Binding>
    <Binding name="ZWOELFSTUFF_EXTERNAL_8" category="ZwoelfStuff">ZwoelfStuff_ExternalAsk(8)</Binding>

    <!--
        ANSWERING ONE, and these carry no body on purpose.

        A binding cannot cast: a line of Lua that reaches a spell is exactly
        what the game forbids. "CLICK <frame>:<button>" is different in kind -
        the game presses the button for you, inside itself, and the cast is
        then as legitimate as a mouse click. It is the only door from a
        keyboard to a spell an addon is allowed to open, and MRT and Fitter
        both walk through it the same way.

        Their names are set in Core/Answers.lua, which also draws the bound
        key in the corner of each cell.
    -->
    <!--
        THE RAID BAR, AND THESE CARRY NO BODY EITHER - for a reason that is
        the same one as the answer cells above and worth stating in its own
        words: putting a skull on the target, dropping a flare on the floor
        and sending a ping are all PROTECTED on this patch. A line of Lua
        cannot do any of them. "CLICK <frame>:<button>" can, because the game
        presses the button itself.

        Twelve, because a bar wider than that is a bar nobody has keys for.
        The number is ns.RaidBar.KEYS in Lua and twelve lines here, which is
        one of the very few numbers in this addon that lives in two places -
        this file is static XML and cannot count. The self test holds the two
        together.

        Their names are set in Core/RaidBar.lua, which also draws the bound
        key in the corner of each place.
    -->
    <Binding name="CLICK ZwoelfStuffRaidBar1:LeftButton" category="ZwoelfStuff" />
    <Binding name="CLICK ZwoelfStuffRaidBar2:LeftButton" category="ZwoelfStuff" />
    <Binding name="CLICK ZwoelfStuffRaidBar3:LeftButton" category="ZwoelfStuff" />
    <Binding name="CLICK ZwoelfStuffRaidBar4:LeftButton" category="ZwoelfStuff" />
    <Binding name="CLICK ZwoelfStuffRaidBar5:LeftButton" category="ZwoelfStuff" />
    <Binding name="CLICK ZwoelfStuffRaidBar6:LeftButton" category="ZwoelfStuff" />
    <Binding name="CLICK ZwoelfStuffRaidBar7:LeftButton" category="ZwoelfStuff" />
    <Binding name="CLICK ZwoelfStuffRaidBar8:LeftButton" category="ZwoelfStuff" />
    <Binding name="CLICK ZwoelfStuffRaidBar9:LeftButton" category="ZwoelfStuff" />
    <Binding name="CLICK ZwoelfStuffRaidBar10:LeftButton" category="ZwoelfStuff" />
    <Binding name="CLICK ZwoelfStuffRaidBar11:LeftButton" category="ZwoelfStuff" />
    <Binding name="CLICK ZwoelfStuffRaidBar12:LeftButton" category="ZwoelfStuff" />

    <Binding name="CLICK ZwoelfStuffAnswer1:LeftButton" category="ZwoelfStuff" />
    <Binding name="CLICK ZwoelfStuffAnswer2:LeftButton" category="ZwoelfStuff" />
    <Binding name="CLICK ZwoelfStuffAnswer3:LeftButton" category="ZwoelfStuff" />
    <Binding name="CLICK ZwoelfStuffAnswer4:LeftButton" category="ZwoelfStuff" />
    <Binding name="CLICK ZwoelfStuffAnswer5:LeftButton" category="ZwoelfStuff" />
    <Binding name="CLICK ZwoelfStuffAnswer6:LeftButton" category="ZwoelfStuff" />
    <Binding name="CLICK ZwoelfStuffAnswer7:LeftButton" category="ZwoelfStuff" />
    <Binding name="CLICK ZwoelfStuffAnswer8:LeftButton" category="ZwoelfStuff" />
</Bindings>
