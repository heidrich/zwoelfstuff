# What the packager builds.
#
# CurseForge does not build a repo by itself: the BigWigs packager runs as a
# GitHub Action on a tag, reads this file, and uploads the result. See
# .github/workflows/release.yml.
#
# The libraries are EMBEDDED on purpose and there is no `externals:` block for
# them - LibSharedMedia is a registry the user's other addons write into, so it
# has to be the copy that ships, not one fetched at build time and possibly a
# different revision than the one this was tested against.
package-as: ZwoelfStuff

# The addon has no -nolib variant to make: nothing here is optional.
enable-nolib-creation: no

# CHANGELOG.md is written by hand and is what a player reads on the project
# page. Left as-is rather than generated from commit messages, which are
# written for whoever picks the code up next and read like it.
manual-changelog: CHANGELOG.md

ignore:
    # Build machinery, not the addon.
    - .github
    - .pkgmeta
    - .gitignore

    # Editor and linter configuration. Useful in a checkout, meaningless in an
    # AddOns folder.
    - .luarc.json
    - .markdownlint.json

    # PARKED FILES. Not in the TOC, so the game never loads them - but the
    # packager copies the repository, it does not read the TOC, so without
    # these lines they shipped anyway. 4.41.0 went out carrying all six.
    #
    # Anything parked belongs in BOTH places: the comment block at the bottom
    # of the TOC, which explains why, and here, which keeps it out of the
    # build.
    #
    # THIS LIST IS COMPUTED, NOT COPIED. The TOC's comment block also names
    # Engine.lua and CoTanks.lua, and both of those are LOADED - listing them
    # here from that block would have shipped a broken addon. Read the TOC's
    # actual load lines and subtract; /zs test would not catch this, because
    # on a checkout every file is present either way.
    - Core/Catalog.lua
    - Core/Groups.lua
    - Core/OptionsGroups.lua
    - Core/OptionsRoutes.lua
    - Core/Probe.lua
    - Core/Routes.lua
